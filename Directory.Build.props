<Project>
  <PropertyGroup>
    <Authors>Filip Dudziec</Authors>
    <Company>Dudziak07</Company>
    <Product>SpectriumLive</Product>
    <Copyright>Copyright (c) 2025-2026 Filip Dudziec</Copyright>
    <RepositoryUrl>https://github.com/Dudziak07/SpectriumLive</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <PackageProjectUrl>https://github.com/Dudziak07/SpectriumLive</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>image-processing;filters;simd;avx2;avx512;computer-vision;ascii</PackageTags>
  </PropertyGroup>
</Project>
