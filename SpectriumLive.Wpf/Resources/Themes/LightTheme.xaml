<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="White"/>
    <SolidColorBrush x:Key="PrimaryForegroundColor" Color="Black"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FF007ACC"/>
</ResourceDictionary>