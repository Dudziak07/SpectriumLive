<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="White"/>
    <SolidColorBrush x:Key="PrimaryForegroundColor" Color="DarkGray"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FFC90094"/>
</ResourceDictionary>