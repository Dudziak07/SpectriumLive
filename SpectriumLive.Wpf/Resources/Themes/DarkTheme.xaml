<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="PrimaryForegroundColor" Color="LightGray"/>
    <SolidColorBrush x:Key="BorderColor" Color="White"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FFC90094"/>
</ResourceDictionary>