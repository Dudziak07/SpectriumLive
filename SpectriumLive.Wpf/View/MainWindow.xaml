<Window x:Class="SpectriumLive.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:strings="clr-namespace:SpectriumLive.Wpf.Resources.Strings"
        xmlns:converters="clr-namespace:SpectriumLive.Wpf.Converters"
        xmlns:local="clr-namespace:SpectriumLive.Wpf"
        
        xmlns:filters="clr-namespace:SpectriumLive.Application.Filters;assembly=SpectriumLive.Application"
        xmlns:convolutionFilters="clr-namespace:SpectriumLive.Application.Filters.Convolution;assembly=SpectriumLive.Application"
        xmlns:textConverters="clr-namespace:SpectriumLive.Application.TextConverters;assembly=SpectriumLive.Application"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        
        mc:Ignorable="d"
        Title="SpectriumLive"
        Height="600" Width="800"
        WindowState="Maximized">

    <Window.InputBindings>
        <KeyBinding Command="{Binding SaveImageCommand}"
                    Key="S"
                    Modifiers="Ctrl"/>
    </Window.InputBindings>
    
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>

        <DataTemplate DataType="{x:Type textConverters:AsciiConverter}">
            <StackPanel>
                <TextBlock Text="{x:Static strings:AppResources.Choose_Mode}" Margin="0,0,0,5" FontWeight="DemiBold"/>
                <RadioButton Content="{x:Static strings:AppResources.Binary}" GroupName="AsciiMode" IsChecked="{Binding AsciiMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static textConverters:AsciiMode.Binary}}" />
                <RadioButton Content="{x:Static strings:AppResources.Simple}" GroupName="AsciiMode" IsChecked="{Binding AsciiMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static textConverters:AsciiMode.Simple}}" />
                <RadioButton Content="{x:Static strings:AppResources.Full}" GroupName="AsciiMode" IsChecked="{Binding AsciiMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static textConverters:AsciiMode.Full}}" />

                <TextBlock Text="{Binding BlockSize, StringFormat='Block Size: {0}'}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <RepeatButton Grid.Column="0" Content="−" Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=BlockSizeSlider}"/>
                    <Slider x:Name="BlockSizeSlider" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding BlockSize, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" IsMoveToPointEnabled="True"/>
                    <RepeatButton Grid.Column="2" Content="+" Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=BlockSizeSlider}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filters:ChannelFilter}">
            <StackPanel>
                <TextBlock Text="{x:Static strings:AppResources.Choose_Selected_Channel}" Margin="0,0,0,5" FontWeight="DemiBold"/>
                <RadioButton Content="{x:Static strings:AppResources.Red}" GroupName="Channel" IsChecked="{Binding SelectedChannel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:ChannelSelector.R}}" />
                <RadioButton Content="{x:Static strings:AppResources.Green}" GroupName="Channel" IsChecked="{Binding SelectedChannel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:ChannelSelector.G}}" />
                <RadioButton Content="{x:Static strings:AppResources.Blue}" GroupName="Channel" IsChecked="{Binding SelectedChannel, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:ChannelSelector.B}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filters:SwapChannelsFilter}">
            <StackPanel>
                <TextBlock Text="{x:Static strings:AppResources.Choose_Selected_Swap_Mode}" Margin="0,0,0,5" FontWeight="DemiBold"/>
                <RadioButton Content="{x:Static strings:AppResources.Red_Blue}" GroupName="SwapMode" IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:SwapMode.RB}}" />
                <RadioButton Content="{x:Static strings:AppResources.Red_Green}" GroupName="SwapMode" IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:SwapMode.RG}}" />
                <RadioButton Content="{x:Static strings:AppResources.Green_Blue}" GroupName="SwapMode" IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:SwapMode.GB}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filters:FisheyeFilter}">
            <StackPanel>
                <TextBlock Text="{Binding Strength, StringFormat='Strength: {0:F2}'}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <RepeatButton Grid.Column="0" Content="−" Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=StrengthSlider}"/>
                    <Slider x:Name="StrengthSlider" Grid.Column="1" Minimum="-2.0" Maximum="2.0" Value="{Binding Strength, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="0.1" TickPlacement="BottomRight" IsMoveToPointEnabled="True"/>
                    <RepeatButton Grid.Column="2" Content="+" Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=StrengthSlider}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filters:BinaryFilter}">
            <StackPanel>
                <TextBlock Text="{x:Static strings:AppResources.BinarizationMethod_Header}" Margin="0,0,0,5" FontWeight="DemiBold"/>
                
                <RadioButton Content="{x:Static strings:AppResources.BinarizationMethod_Manual}" GroupName="BinarizationMethod" 
                             IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:BinarizationMethod.Manual}}" />
                <Grid Margin="20,2,0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMethod}" Value="{x:Static filters:BinarizationMethod.Manual}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <RepeatButton Grid.Column="0" Content="−" Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=ManualThresholdSlider}" Padding="5,0"/>
                    <Slider x:Name="ManualThresholdSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ManualThreshold, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                    <RepeatButton Grid.Column="2" Content="+" Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=ManualThresholdSlider}" Padding="5,0"/>
                    <TextBox Grid.Column="3" Text="{Binding ManualThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="3,0,0,0"/>
                </Grid>

                <RadioButton Content="{x:Static strings:AppResources.BinarizationMethod_PercentBlack}" GroupName="BinarizationMethod" 
                             IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:BinarizationMethod.PercentBlack}}" />
                <Grid Margin="20,2,0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMethod}" Value="{x:Static filters:BinarizationMethod.PercentBlack}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <RepeatButton Grid.Column="0" Content="−" Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=PercentBlackSlider}" Padding="5,0"/>
                    <Slider x:Name="PercentBlackSlider" Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding PercentBlack, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="0.01" IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                    <RepeatButton Grid.Column="2" Content="+" Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=PercentBlackSlider}" Padding="5,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding PercentBlack, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <RadioButton Content="{x:Static strings:AppResources.BinarizationMethod_MeanIterative}" GroupName="BinarizationMethod" 
                             IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:BinarizationMethod.MeanIterative}}" 
                             Margin="0,0,0,5"/>

                <RadioButton Content="{x:Static strings:AppResources.BinarizationMethod_Otsu}" GroupName="BinarizationMethod" 
                             IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static filters:BinarizationMethod.Otsu}}" 
                             Margin="0,0,0,5"/>

                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static strings:AppResources.Threshold_Label}" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding CalculatedThreshold}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static strings:AppResources.PercentBlack_Label}" FontSize="10" HorizontalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding PercentBlack, StringFormat='{}{0:P1}'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type convolutionFilters:GaussianBlurFilter}">
            <StackPanel>
                <TextBlock Text="{Binding Sigma, StringFormat='Sigma (σ): {0:F2}'}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RepeatButton Grid.Column="0" Content="−" Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=SigmaSlider}"/>
                    <Slider x:Name="SigmaSlider" Grid.Column="1" Minimum="0.1" Maximum="5.0" Value="{Binding Sigma, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="0.1" TickPlacement="BottomRight" IsMoveToPointEnabled="True"/>
                    <RepeatButton Grid.Column="2" Content="+" Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=SigmaSlider}"/>
                </Grid>

                <TextBlock Text="{Binding KernelSize, StringFormat='Kernel Size: {0}x{0}'}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RepeatButton Grid.Column="0" Content="−" Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=KernelSizeSlider}"/>
                    <Slider x:Name="KernelSizeSlider" Grid.Column="1" Minimum="3" Maximum="15" Value="{Binding KernelSize, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="2" TickPlacement="BottomRight" IsMoveToPointEnabled="True"/>
                    <RepeatButton Grid.Column="2" Content="+" Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=KernelSizeSlider}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static strings:AppResources.File_Header}">
                <MenuItem Header="{x:Static strings:AppResources.LoadImageButton_Content}" Command="{Binding LoadImageCommand}"/>
                <MenuItem Header="{x:Static strings:AppResources.SaveImageButton_Content}" Command="{Binding SaveImageCommand}"/>
            </MenuItem>

            <MenuItem Header="{x:Static strings:AppResources.MenuView_Header}">
                <MenuItem Header="{x:Static strings:AppResources.MenuTheme_Header}">
                    <MenuItem Header="{x:Static strings:AppResources.MenuThemeLight_Header}" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                    <MenuItem Header="{x:Static strings:AppResources.MenuThemeDark_Header}" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                </MenuItem>

                <MenuItem Header="{x:Static strings:AppResources.MenuLanguage_Header}">
                    <MenuItem Header="{x:Static strings:AppResources.MenuLanguagePolish_Header}" Command="{Binding SetLanguageCommand}" CommandParameter="pl-PL"/>
                    <MenuItem Header="{x:Static strings:AppResources.MenuLanguageEnglish_Header}" Command="{Binding SetLanguageCommand}" CommandParameter="en-US"/>
                </MenuItem>

                <Separator/>
                
                <MenuItem Header="{x:Static strings:AppResources.MenuClearImage_Header}" Command="{Binding ClearImageCommand}"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource SecondaryBackgroundColor}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TabControl>
                            <TabItem Header="{x:Static strings:AppResources.File_Header}">
                                <StackPanel Margin="5">
                                    <Button Content="{x:Static strings:AppResources.LoadImageButton_Content}" Command="{Binding LoadImageCommand}"/>
                                    <Button Content="{x:Static strings:AppResources.SaveImageButton_Content}" Command="{Binding SaveImageCommand}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="{x:Static strings:AppResources.LiveCamera_Header}">
                                <StackPanel Margin="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCameras}" DisplayMemberPath="Name" SelectedValuePath="Index" SelectedValue="{Binding SelectedCameraIndex}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="DropDownOpened">
                                                    <i:InvokeCommandAction Command="{Binding LoadCamerasCommand}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </ComboBox>
                                        <Button Grid.Column="1" Content="⟳" Command="{Binding LoadCamerasCommand}" ToolTip="Refresh camera list" Margin="5,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                        <Button Margin="5" Command="{Binding ToggleCameraCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="{x:Static strings:AppResources.StartButton_Content}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCameraRunning}" Value="True">
                                                            <Setter Property="Content" Value="{x:Static strings:AppResources.StopButton_Content}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Margin="5" Command="{Binding FreezeCameraCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="{x:Static strings:AppResources.FreezeButton_Content}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCameraFrozen}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                        <GroupBox Header="{x:Static strings:AppResources.ImageProcessing_Header}">
                            <ItemsControl ItemsSource="{Binding ImageProcessors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}"
                                                Command="{Binding DataContext.SelectProcessorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,2">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.SelectedProcessor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </StackPanel>

                    <GroupBox Header="{x:Static strings:AppResources.ImageProcessingProperties_Header}"
                              DockPanel.Dock="Bottom"
                              Visibility="{Binding SelectedProcessor.Processor.HasConfigurableProperties, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <ContentControl Content="{Binding SelectedProcessor.Processor}" Margin="5"/>
                    </GroupBox>
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Grid Background="{DynamicResource PrimaryBackgroundColor}">
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5">
                <Viewbox>
                    <Image Source="{Binding ProcessedImage}"/>
                </Viewbox>
            </Border>
            <Border MaxWidth="200" MaxHeight="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="5">
                <Image Source="{Binding OriginalImage}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>