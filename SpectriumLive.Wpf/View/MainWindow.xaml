<Window x:Class="SpectriumLive.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpectriumLive.Wpf"
        mc:Ignorable="d"
        Title="SpectriumLive" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Load Image" Margin="0,0,0,10"/>
            <Label Content="Available Filters:"/>

            <ListBox ItemsSource="{Binding Filters}" DisplayMemberPath="Name" Height="450"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Gray" BorderThickness="1" Grid.Column="0" Margin="5">
                <Image x:Name="OriginalImage"/>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Grid.Column="1" Margin="5">
                <Image x:Name="ProcessedImage"/>
            </Border>
        </Grid>
    </Grid>
</Window>