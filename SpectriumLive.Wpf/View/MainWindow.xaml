<Window x:Class="SpectriumLive.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:res="clr-namespace:SpectriumLive.Wpf.Resources.Strings"
        xmlns:converters="clr-namespace:SpectriumLive.Wpf.Converters"
        xmlns:local="clr-namespace:SpectriumLive.Wpf"
        mc:Ignorable="d"
        Title="SpectriumLive" Height="600" Width="800">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <CollectionViewSource x:Key="GroupedProcessors" Source="{Binding ImageProcessors}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:AppResources.MenuView_Header}">
                <MenuItem Header="{x:Static res:AppResources.MenuTheme_Header}">
                    <MenuItem Header="{x:Static res:AppResources.MenuThemeLight_Header}" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                    <MenuItem Header="{x:Static res:AppResources.MenuThemeDark_Header}" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource SecondaryBackgroundColor}" Margin="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="5">
                <StackPanel>
                    <GroupBox Header="{x:Static res:AppResources.File_Header}" Foreground="{DynamicResource PrimaryForegroundColor}" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <Button Content="{x:Static res:AppResources.LoadImageButton_Content}" Command="{Binding LoadImageCommand}"/>
                            <Button Content="{x:Static res:AppResources.SaveImageButton_Content}" Command="{Binding SaveImageCommand}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{x:Static res:AppResources.LiveCamera_Header}" Foreground="{DynamicResource PrimaryForegroundColor}" Margin="0,0,0,10">
                        <StackPanel Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCameras}" DisplayMemberPath="Name" SelectedValuePath="Index" SelectedValue="{Binding SelectedCameraIndex}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="DropDownOpened">
                                            <i:InvokeCommandAction Command="{Binding LoadCamerasCommand}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ComboBox>
                                <Button Grid.Column="1" Content="⟳" Command="{Binding LoadCamerasCommand}" ToolTip="Refresh camera list" Margin="5,0,0,0" Padding="5,2"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Button Content="{x:Static res:AppResources.StartButton_Content}" Margin="5" Command="{Binding StartCameraCommand}"/>
                                <Button Content="{x:Static res:AppResources.StopButton_Content}" Margin="5" Command="{Binding StopCameraCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{x:Static res:AppResources.ImageProcessing_Header}" Foreground="{DynamicResource PrimaryForegroundColor}" Margin="0,0,0,10">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Source={StaticResource GroupedProcessors}}"
                                     SelectedItem="{Binding SelectedProcessor}"
                                     DisplayMemberPath="Name"
                                     MaxHeight="500">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="Bold" Text="{Binding Name}" Margin="0,5"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                            </ListBox>

                            <StackPanel Visibility="{Binding IsTextConverterSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                                <TextBlock Text="{Binding AsciiBlockSizeText}" Foreground="{DynamicResource PrimaryForegroundColor}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <Slider Minimum="1" Maximum="20" Value="{Binding AsciiBlockSize, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Background="{DynamicResource PrimaryBackgroundColor}" Margin="5">
            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5">
                <Viewbox>
                    <Image Source="{Binding ProcessedImage}"/>
                </Viewbox>
            </Border>
            <Border MaxWidth="200" MaxHeight="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="5">
                <Image Source="{Binding OriginalImage}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>