<Window x:Class="SpectriumLive.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:res="clr-namespace:SpectriumLive.Wpf.Resources.Strings"
        xmlns:local="clr-namespace:SpectriumLive.Wpf"
        mc:Ignorable="d"
        Title="SpectriumLive" Height="600" Width="800">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:AppResources.MenuView_Header}">
                <MenuItem Header="{x:Static res:AppResources.MenuTheme_Header}">
                    <MenuItem Header="{x:Static res:AppResources.MenuThemeLight_Header}" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                    <MenuItem Header="{x:Static res:AppResources.MenuThemeDark_Header}" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Left" Width="250" Background="{DynamicResource SecondaryBackgroundColor}" Margin="5"/>

        <Grid Background="{DynamicResource PrimaryBackgroundColor}" Margin="5"/>
    </DockPanel>
</Window>