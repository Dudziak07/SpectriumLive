<Window x:Class="SpectriumLive.Wpf.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpectriumLive.Wpf"
        mc:Ignorable="d"
        Title="SpectriumLive" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button
                Content="Load Image"
                Margin="0,0,0,10"
                Command="{Binding LoadImageCommand}"/>

            <Label Content="Live Camera:"/>
            <ComboBox
                ItemsSource="{Binding AvailableCameras}"
                SelectedIndex="{Binding SelectedCameraIndex}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                <Button Content="Start" Margin="5" Command="{Binding StartCameraCommand}"/>
                <Button Content="Stop" Margin="5" Command="{Binding StopCameraCommand}"/>
            </StackPanel>

            <Label
                Content="Available Filters:"/>
            <ListBox
                ItemsSource="{Binding Filters}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedFilter}"/>
            
            <Label
                Content="Text Convertets:"/>
            <ListBox
                ItemsSource="{Binding TextConverters}"
                DisplayMemberPath="Name"
                SelectedItem="{Binding SelectedTextConverter}"/>

            <Button
                Content="Save Image"
                Margin="0,10,0,0"
                Command="{Binding SaveImageCommand}"/>

        </StackPanel>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Gray" BorderThickness="1" Grid.Column="0" Margin="5">
                <Image x:Name="OriginalImage" Source="{Binding OriginalImage}"/>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Grid.Column="1" Margin="5">
                <Image x:Name="ProcessedImage" Source="{Binding ProcessedImage}"/>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Grid.Column="2" Margin="5">
                <TextBox Text="{Binding AsciiResult}" FontFamily="Consolas" FontSize="4" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>